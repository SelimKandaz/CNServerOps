[Unit]
Description=CNServerOps staged ASUS firmware resume checkpoint
Documentation=file:/opt/cnserverops/current/README.md
After=local-fs.target network-online.target cnserverops-clone-firstboot.service
Before=cnserverops-console.service
Wants=network-online.target
ConditionPathExists=/opt/cnserverops/current

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m cnserverops.cli asus-firmware-resume --config /etc/cnserverops/production.json
WorkingDirectory=/opt/cnserverops/current
UMask=0077
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
